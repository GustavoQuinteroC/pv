# Copia este archivo a .env y cambia los valores. Los de aquí son de ejemplo.

# MongoDB (docker compose lo crea con estas credenciales)
MONGO_USUARIO=pv
MONGO_CLAVE=cambia-esta-clave

# Primer administrador (se crea solo si todavía no hay usuarios)
ADMIN_CORREO=admin@ejemplo.com
ADMIN_CLAVE=cambia-esta-clave

# true carga productos de ejemplo la primera vez
SEMBRAR_DEMO=true
